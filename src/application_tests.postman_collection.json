{
  "info": {
    "name": "Microservices Smoke Tests",
    "description": "Тесты Newman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. Session Service - Health Check",
      "request": {
        "method": "GET",
        "url": "{{session_url}}/actuator/health",
        "auth": {
          "type": "basic",
          "basic": [
            {"key": "username", "value": "service_user"},
            {"key": "password", "value": "service_password"}
          ]
        }
      }
    },
    {
      "name": "01. Session Service - User Registration",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{gateway_url}}/api/v1/gateway/users",
        "auth": {
          "type": "basic",
          "basic": [
            {"key": "username", "value": "admin"},
            {"key": "password", "value": "password"}
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"testuser\",\"password\":\"Testpass123!\"}"
        }
      }
    },
    {
      "name": "02. Hotel Service - Get Hotels",
      "request": {
        "method": "GET",
        "url": "{{gateway_url}}/api/v1/gateway/hotels",
        "auth": {
          "type": "basic",
          "basic": [
            {"key": "username", "value": "admin"},
            {"key": "password", "value": "password"}
          ]
        }
      }
    }
  ]
}